{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "classpath:/json-schemas/file-search.schema.json",
   "title": "Busca de Arquivos",
   "description": "Pesquisa arquivos pelo nome dentro do diretório autorizado no servidor. Aceita padrões glob, como *.pdf ou contrato*",
   "type": "object",
   "properties": {
      "pattern": {
         "type": "string",
         "description" : "Padrão glob para o caminho/nome do arquivo"
      },
      "recursive": {
         "type": "boolean",
         "description" : "Pesquisar em subdiretórios???",
         "default": false
      },
      "max_results": {
         "type": "integer",
         "minimum": 1,
         "maximum": 100,
         "description": "Quantidade máxima de resultados",
         "pattern": "\\d+",
         "default": 1
      }
   },
   "required": [ "pattern" ],
   "additionalProperties": false
}
