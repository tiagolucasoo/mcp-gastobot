# Arquivo modelo. Copie para .env e ajuste os caminhos da sua máquina:
#   Windows:     copy .env.example .env
#   Linux/macOS: cp .env.example .env
#
# O .env é ignorado pelo Git porque contém caminhos locais.

# Diretório do HOST que será montado no contêiner (diretório autorizado).
# Windows: use barras normais, p.ex. D:/desenvolvimento
# Linux/macOS: p.ex. /home/usuario/desenvolvimento
MCP_FILES_HOST=D:/desenvolvimento

# Diretório do contêiner onde o host será montado.
# Não altere sem ajustar também o compose.yaml.
MCP_CONTAINER=/opt/mcp
MCP_FILES_CONTAINER=${MCP_CONTAINER}/files
